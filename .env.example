# ---- Predge data access -------------------------------------------------
# LIVE mode: a THROWAWAY wallet holding a little USDC on Base. Each Predge call
# costs $0.005–$0.03, so ~$1 covers a long demo. Leave this unset to run in
# MOCK mode (sample data, no funds, no chain).
# PREDGE_AGENT_PRIVATE_KEY=0x...

# Force sample data even if a key is set (useful for CI / reproducible demos):
# PREDGE_MOCK=1

# Override the API base (defaults to https://api.predge.io):
# PREDGE_API_BASE=https://api.predge.io

# ---- Model provider -----------------------------------------------------
# Default: Amazon Bedrock (needs AWS creds with Claude model access).
# Easiest alternative if you lack Bedrock access — set ONE of these:
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# MODEL_ID=claude-sonnet-4-5        # overrides the model id for any provider

# ---- Watcher (watch.py) -------------------------------------------------
# SCAN_INTERVAL_SEC=900
# MIN_CONVICTION=70
# NOTIFY_WEBHOOK=https://...        # alerts POSTed here (Telegram/Slack/etc.)
# MAX_SCANS=0                       # 0 = run forever; set N to stop after N
